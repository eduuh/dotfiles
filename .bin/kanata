#!/bin/zsh

# Kanata remains the macOS remapper until Keyflow has a macOS runtime.
if [[ "$(uname)" != "Darwin" ]]; then
    print -u2 "Linux uses Keyflow. Use 'keyflow status' or 'keyflow restart'."
    exit 1
fi

# Resolve the real binary rather than this wrapper.
path=(${path:#$HOME/.bin})
sudo kanata --cfg "$HOME/.config/keyboard/colemak.kbd"
