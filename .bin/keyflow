#!/bin/zsh

if [[ "$(uname)" != "Linux" ]]; then
    print -u2 "This wrapper manages the separately installed Linux Keyflow service."
    exit 1
fi

case "${1:-status}" in
    status)   systemctl --no-pager status keyflow.service ;;
    log)      journalctl -u keyflow.service -e ;;
    start)    sudo systemctl start keyflow.service ;;
    restart)  sudo systemctl restart keyflow.service ;;
    stop)     sudo systemctl stop keyflow.service ;;
    rollback) sudo /usr/local/lib/keyflow/rollback ;;
    -h|--help)
        print "Usage: keyflow [status|log|start|restart|stop|rollback]"
        print "Release every key before starting. Stop returns to the raw keyboard."
        print "Rollback restores the locally archived Kanata installation, if present."
        ;;
    *)
        print -u2 "Unknown command: $1"
        exit 2
        ;;
esac
